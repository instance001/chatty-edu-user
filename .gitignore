# Runtime data generated by Chatty-EDU.
/data/config/*
!/data/config/.gitkeep
!/data/config/bookkeeper/
/data/config/bookkeeper/*
!/data/config/bookkeeper/.gitkeep

/data/homework/assigned/*
!/data/homework/assigned/.gitkeep
/data/homework/completed/*
!/data/homework/completed/.gitkeep
/data/homework/outgoing/*
!/data/homework/outgoing/.gitkeep
/data/homework/marking/*
!/data/homework/marking/.gitkeep
/data/homework/printables/*
!/data/homework/printables/.gitkeep
/data/homework/rubrics/*
!/data/homework/rubrics/.gitkeep

/data/revision/notes/*
!/data/revision/notes/.gitkeep
/data/revision/past_papers/*
!/data/revision/past_papers/.gitkeep

/data/logs/*
!/data/logs/.gitkeep
/data/modules/*
!/data/modules/.gitkeep
/data/runtime/*
!/data/runtime/.gitkeep
/data/themes/*
!/data/themes/.gitkeep
/data/Chatty_Sandbox/*
!/data/Chatty_Sandbox/.gitkeep

# User-supplied local model files stay out of git.
/data/models/*
!/data/models/.gitkeep
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# OS/editor noise.
.DS_Store
Thumbs.db
*.log
